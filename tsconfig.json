{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,

    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo",

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@chatterang/contracts": ["packages/contracts/src/index.ts"],
      "@chatterang/contracts/*": ["packages/contracts/src/*.ts"],
      "@chatterang/inference-node": ["packages/inference-node/src/index.ts"],
      "@chatterang/onnx-node": ["packages/onnx-node/src/index.ts"],
      "@chatterang/cordis-aimatey": ["packages/cordis-aimatey/src/index.ts"],
      // The tunnel, mapped ONE ENTRY POINT AT A TIME and with no wildcard.
      // `"@chatterang/tunnel/*": ["packages/tunnel/src/*"]` would be shorter
      // and would resolve `@chatterang/tunnel/host` for anything that asked —
      // including `src/`, whose ban on that specifier would then be a rule
      // TypeScript happily worked around. There is no `.` entry for the same
      // reason: a bare `@chatterang/tunnel` must have nothing to resolve to.
      // `tests/layering.test.ts` asserts all three of these facts.
      "@chatterang/tunnel/wire": ["packages/tunnel/src/wire/index.ts"],
      "@chatterang/tunnel/codec": ["packages/tunnel/src/codec/index.ts"],
      "@chatterang/tunnel/pairing": ["packages/tunnel/src/pairing/index.ts"],
      "@chatterang/tunnel/pake": ["packages/tunnel/src/pake/index.ts"],
      "@chatterang/tunnel/stream": ["packages/tunnel/src/stream/index.ts"],
      "@chatterang/tunnel/binding": ["packages/tunnel/src/binding/index.ts"],
      "@chatterang/tunnel/client": ["packages/tunnel/src/client/index.ts"],
      "@chatterang/tunnel/host": ["packages/tunnel/src/host/index.ts"],
      "@chatterang/desktop/*": ["apps/desktop/src/*"],
      "@chatterang/server": ["apps/server/src/index.ts"],
      "@chatterang/server/*": ["apps/server/src/*"]
    }
  },
  "include": [
    "src",
    "tests",
    "packages/*/src",
    "apps/desktop/src",
    "apps/server/src",
    "vite.config.ts",
    "capacitor.config.ts"
  ]
}
