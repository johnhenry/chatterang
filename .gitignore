node_modules
dist/
.DS_Store
*.log

# Capacitor native projects are generated by `npx cap add`.
/ios/
/android/

# Downloaded model weights never belong in the repository.
#
# Anchored. An unanchored `models/` also matched `src/features/models/`, so four
# UI source files were silently untracked: a fresh clone could not build, and
# every green test run was measured against a working tree git did not have.
/models/
/apps/desktop/models/
*.gguf
*.onnx
*.litertlm

# tsc emit that lands beside sources when --noEmit is overridden. Vite resolves
# .js before .tsx for extensionless imports, so a stale sibling silently shadows
# the real source in dev. `npm run build` no longer emits these; this is a guard.
src/**/*.js
src/**/*.js.map
tests/**/*.js
tests/**/*.js.map
/capacitor.config.js

# Desktop build artefacts. `apps/desktop/build` is esbuild output and
# `apps/desktop/app` is a verbatim copy of `dist/`; both are reproducible from
# `npm run desktop:build` and `npm run desktop:sync`.
/apps/desktop/build/
# The private host bundle `tests/server.test.ts` builds so that it and
# `tests/desktop-host-split.test.ts` do not race over one output directory.
/apps/desktop/build.server-test/
/apps/desktop/app/
/apps/server/build/

# llama.cpp is neither vendored nor submoduled: `native/plugin-llama-cpp/tools/
# build-llama-xcframework.sh` clones a pinned tag into `.cache/` and builds the
# XCFramework that Package.swift's `llama` binaryTarget points at. Both are
# reproducible from that script and the tag pinned inside it. Anchored, so
# `.cache` elsewhere in the tree is not silently swallowed.
/.cache/
/native/plugin-llama-cpp/ios/llama.xcframework/

# Gradle output for the Android plugin module. The module itself is tracked —
# `build.gradle`, `src/main` and `src/main/cpp` — but everything under `build/`
# and `.cxx/` is regenerated by `:chatterang-plugin-llama-cpp:assembleDebug`.
# Anchored, so a `build/` directory elsewhere in the tree is not swallowed.
/native/plugin-llama-cpp/android/build/
/native/plugin-llama-cpp/android/.cxx/

# Runtime lock for the scheduled-tasks MCP server: a session id, a pid and
# a start time for one machine at one moment. It was tracked, so every run
# that acquired or released it showed as a working-tree change in an
# unrelated branch.
.claude/scheduled_tasks.lock
