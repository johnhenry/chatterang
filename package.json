{
  "name": "chatterang",
  "version": "1.0.0",
  "private": true,
  "description": "Chatterang \u2014 a privacy-first, on-device AI super app. Local LLMs, VLMs, speech, and image generation, routed through @johnhenry/aimatey.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync": "npm run build:web && cap sync",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync && cap open android",
    "verify": "npm run typecheck && npm run test && npm run build:web"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.0",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/status-bar": "8.0.3",
    "@johnhenry/aimatey": "0.1.0",
    "@johnhenry/aimatey-backend": "0.2.0",
    "@johnhenry/aimatey-backend-browser": "0.1.2",
    "@johnhenry/aimatey-core": "0.3.0",
    "@johnhenry/aimatey-errors": "0.2.0",
    "@johnhenry/aimatey-frontend": "0.1.2",
    "@johnhenry/aimatey-middleware": "0.2.1",
    "@johnhenry/aimatey-types": "0.3.0",
    "@johnhenry/aimatey-utils": "0.2.0",
    "@johnhenry/mcp-query": "^0.0.0",
    "dexie": "^4.4.5",
    "just-bash": "^3.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@johnhenry/aimatey-testing": "0.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^28.0.0",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
